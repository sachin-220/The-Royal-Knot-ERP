<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Live Variations -->
        <record id="seq_wedding_variation" model="ir.sequence">
            <field name="name">Wedding Variation Sequence</field>
            <field name="code">knotcore.wedding.variation</field>
            <field name="prefix">VAR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Vendor Final Settlements -->
        <record id="seq_vendor_settlement" model="ir.sequence">
            <field name="name">Vendor Settlement Sequence</field>
            <field name="code">knotcore.vendor.settlement</field>
            <field name="prefix">SETTLE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
