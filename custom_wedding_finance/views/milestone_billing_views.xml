<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Milestone Billing Tree View -->
    <record id="view_client_milestone_tree" model="ir.ui.view">
        <field name="name">knotcore.client.milestone.tree</field>
        <field name="model">knotcore.client.milestone</field>
        <field name="arch" type="xml">
            <tree string="Client Milestone Invoices" decoration-success="state == 'paid'" decoration-warning="state == 'invoiced'" decoration-danger="state == 'overdue'">
                <field name="wedding_id"/>
                <field name="name"/>
                <field name="milestone_type"/>
                <field name="percentage" widget="percentage"/>
                <field name="amount" sum="Total Milestones"/>
                <field name="due_date"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'invoiced'" decoration-info="state == 'pending'"/>
            </tree>
        </field>
    </record>

    <!-- Milestone Billing Form View -->
    <record id="view_client_milestone_form" model="ir.ui.view">
        <field name="name">knotcore.client.milestone.form</field>
        <field name="model">knotcore.client.milestone</field>
        <field name="arch" type="xml">
            <form string="Client Wedding Milestone Invoice">
                <header>
                    <button name="action_create_invoice" string="Generate Customer Invoice 📄" type="object" invisible="state != 'pending'" class="oe_highlight"/>
                    <button name="action_mark_paid" string="Confirm Payment Received ✅" type="object" invisible="state == 'paid'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="wedding_id"/></h3>
                    </div>
                    <group>
                        <group string="Billing Stage">
                            <field name="milestone_type"/>
                            <field name="percentage" widget="percentage"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Financials">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_client_milestone" model="ir.actions.act_window">
        <field name="name">Client Milestone Billing</field>
        <field name="res_model">knotcore.client.milestone</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
