<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 3-Way Matching Tree View -->
    <record id="view_vendor_settlement_tree" model="ir.ui.view">
        <field name="name">knotcore.vendor.settlement.tree</field>
        <field name="model">knotcore.vendor.settlement</field>
        <field name="arch" type="xml">
            <tree string="Vendor Final Settlements" decoration-danger="matching_status in ('discrepancy', 'duplicate_suspect')" decoration-success="matching_status == 'matched'">
                <field name="name"/>
                <field name="wedding_id"/>
                <field name="vendor_id"/>
                <field name="category_id"/>
                <field name="contract_amount"/>
                <field name="approved_extras_amount"/>
                <field name="advance_paid_amount"/>
                <field name="final_settlement_payable" sum="Total Settlements Payable"/>
                <field name="matching_status" widget="badge" decoration-success="matching_status == 'matched'" decoration-warning="matching_status == 'discrepancy'" decoration-danger="matching_status == 'duplicate_suspect'"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- 3-Way Matching Form View -->
    <record id="view_vendor_settlement_form" model="ir.ui.view">
        <field name="name">knotcore.vendor.settlement.form</field>
        <field name="model">knotcore.vendor.settlement</field>
        <field name="arch" type="xml">
            <form string="Vendor 3-Way Matching &amp; Settlement Statement">
                <header>
                    <button name="action_approve_settlement" string="Approve Final Settlement ✅" type="object" invisible="state != 'audit'" class="oe_highlight"/>
                    <button name="action_disburse_payment" string="Disburse Payment 💳" type="object" invisible="state != 'approved'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="audit,approved,disbursed"/>
                </header>
                <sheet>
                    <!-- Discrepancy or Duplicate Banner -->
                    <div class="alert alert-danger" role="alert" invisible="matching_status == 'matched'" style="margin-bottom:15px;">
                        <h4>⚠️ <b>AUDIT ALERT: <field name="matching_status" readonly="1"/></b></h4>
                        <field name="discrepancy_reason" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="vendor_id"/></h3>
                    </div>

                    <group>
                        <group string="3-Way Matching Documents">
                            <field name="wedding_id"/>
                            <field name="category_id"/>
                            <field name="quote_id"/>
                            <field name="purchase_order_id"/>
                            <field name="vendor_bill_id"/>
                            <field name="submitted_bill_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Settlement Formula Ledger">
                            <field name="contract_amount" widget="monetary"/>
                            <field name="approved_extras_amount" widget="monetary" string="+ Approved Variations"/>
                            <field name="advance_paid_amount" widget="monetary" string="- Advance Paid to Date"/>
                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="final_settlement_payable"/>
                            </div>
                            <field name="final_settlement_payable" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" style="font-size:1.4em; font-weight:bold; color:#157347;"/>
                        </group>
                    </group>

                    <group string="Matching Audit Result">
                        <field name="matching_status" widget="badge"/>
                        <field name="discrepancy_amount" widget="monetary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vendor_settlement" model="ir.actions.act_window">
        <field name="name">Vendor 3-Way Matching &amp; Settlements</field>
        <field name="res_model">knotcore.vendor.settlement</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
