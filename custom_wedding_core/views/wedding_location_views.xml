<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_wedding_location_form" model="ir.ui.view">
        <field name="name">custom.wedding.location.form</field>
        <field name="model">custom.wedding.location</field>
        <field name="arch" type="xml">
            <form string="Wedding Venue Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Venue / Palace Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Rambagh Palace"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Geography &amp; Architecture">
                            <field name="destination" widget="radio" options="{'horizontal': true}"/>
                            <field name="venue_type"/>
                            <field name="max_guest_capacity"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Point of Contact">
                            <field name="contact_name"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="contact_email" widget="email"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address" nolabel="1" placeholder="Detailed street address and access instructions..."/>
                    </group>
                    <notebook>
                        <page string="Logistics &amp; Sound Regulations">
                            <field name="notes" placeholder="Sound curfew, generator requirements, unloading docks..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_wedding_location_tree" model="ir.ui.view">
        <field name="name">custom.wedding.location.tree</field>
        <field name="model">custom.wedding.location</field>
        <field name="arch" type="xml">
            <tree string="Venues &amp; Palaces">
                <field name="name"/>
                <field name="destination" widget="badge"/>
                <field name="venue_type"/>
                <field name="max_guest_capacity"/>
                <field name="contact_name"/>
                <field name="contact_phone"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_custom_wedding_location" model="ir.actions.act_window">
        <field name="name">Venues &amp; Locations</field>
        <field name="res_model">custom.wedding.location</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
