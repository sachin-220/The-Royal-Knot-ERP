<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Wedding Form View -->
    <record id="view_custom_wedding_form" model="ir.ui.view">
        <field name="name">custom.wedding.form</field>
        <field name="model">custom.wedding</field>
        <field name="arch" type="xml">
            <form string="Royal Wedding Event">
                <header>
                    <button name="action_set_consultation" string="Schedule Consultation" type="object" 
                            states="enquiry" class="btn-primary"/>
                    <button name="action_confirm" string="Confirm &amp; Deposit Paid" type="object" 
                            states="consultation" class="btn-success"/>
                    <button name="action_start_planning" string="Activate Planning" type="object" 
                            states="confirmed" class="btn-primary"/>
                    <button name="action_execute_big_day" string="Launch Day-Of Command" type="object" 
                            states="planning" class="btn-warning"/>
                    <button name="action_reconciliation" string="Post-Event Reconciliation" type="object" 
                            states="in_execution" class="btn-info"/>
                    <button name="action_done" string="Mark as Completed" type="object" 
                            states="reconciliation" class="btn-secondary"/>
                    <button name="action_cancel" string="Cancel Wedding" type="object" 
                            states="enquiry,consultation,confirmed,planning" 
                            confirm="Are you sure you want to cancel this royal wedding?"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="enquiry,consultation,confirmed,planning,in_execution,reconciliation,done"/>
                </header>
                <sheet>
                    <!-- ML Drift Warning Banner -->
                    <div class="alert alert-danger mb-3" role="alert" 
                         attrs="{'invisible': [('margin_drift_risk', '!=', 'critical')]}">
                        <strong><i class="fa fa-exclamation-triangle"/> ML Margin Warning: </strong>
                        <field name="drift_risk_explanation" readonly="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert" 
                         attrs="{'invisible': [('margin_drift_risk', '!=', 'moderate')]}">
                        <strong><i class="fa fa-info-circle"/> ML Operational Advisory: </strong>
                        <field name="drift_risk_explanation" readonly="1" class="d-inline"/>
                    </div>

                    <!-- Smart KPI Stat Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users" type="action">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="predicted_guests"/></span>
                                <span class="o_stat_text">ML Forecast</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-cutlery" type="action">
                            <div class="o_stat_info">
                                <span class="o_stat_value">+<field name="recommended_plate_buffer"/></span>
                                <span class="o_stat_text">Plate Buffer</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-calendar" type="action">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="duration_days"/> Days</span>
                                <span class="o_stat_text">Event Duration</span>
                            </div>
                        </button>
                    </div>

                    <!-- Header Title Block -->
                    <div class="oe_title mb-4">
                        <span class="o_form_label text-muted">Wedding Master Record</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="wedding_title" placeholder="e.g. Royal Heritage Wedding"/>
                        </h3>
                    </div>

                    <!-- Main Data Form Sections -->
                    <group>
                        <group string="Client &amp; Team Details">
                            <field name="partner_id" widget="res_partner_many2one" 
                                   context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="planner_id" widget="many2one_avatar_user"/>
                            <field name="coordinator_ids" widget="many2many_tags" 
                                   options="{'color_field': 'color'}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Destination &amp; Schedule">
                            <field name="destination" widget="radio" options="{'horizontal': true}"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="package_id" options="{'no_create': True}"/>
                            <label for="wedding_date_start" string="Event Dates"/>
                            <div class="o_row">
                                <field name="wedding_date_start" widget="daterange" 
                                       options="{'related_end_date': 'wedding_date_end'}"/>
                                <span class="o_form_label mx-2">to</span>
                                <field name="wedding_date_end" widget="daterange" 
                                       options="{'related_start_date': 'wedding_date_start'}"/>
                            </div>
                        </group>
                    </group>

                    <group>
                        <group string="Scope &amp; Budget Ceiling">
                            <field name="guest_count"/>
                            <field name="theme"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="ML Intelligence Guardrails">
                            <field name="predicted_guest_surge" widget="percentage"/>
                            <field name="recommended_plate_buffer"/>
                            <field name="margin_drift_risk" widget="badge" 
                                   decoration-success="margin_drift_risk == 'low'"
                                   decoration-warning="margin_drift_risk == 'moderate'"
                                   decoration-danger="margin_drift_risk == 'critical'"/>
                        </group>
                    </group>
                </sheet>
                <!-- Odoo Native Audit Chatter & Activity Tracking -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Custom Wedding Tree / List View -->
    <record id="view_custom_wedding_tree" model="ir.ui.view">
        <field name="name">custom.wedding.tree</field>
        <field name="model">custom.wedding</field>
        <field name="arch" type="xml">
            <tree string="Royal Weddings" decoration-info="state in ('enquiry', 'consultation')"
                  decoration-primary="state == 'confirmed'" decoration-warning="state == 'in_execution'"
                  decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="destination" widget="badge"/>
                <field name="location_id"/>
                <field name="wedding_date_start"/>
                <field name="guest_count"/>
                <field name="predicted_guests" optional="show"/>
                <field name="recommended_plate_buffer" optional="show"/>
                <field name="budget_total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="planner_id" widget="many2one_avatar_user"/>
                <field name="margin_drift_risk" widget="badge" 
                       decoration-success="margin_drift_risk == 'low'"
                       decoration-warning="margin_drift_risk == 'moderate'"
                       decoration-danger="margin_drift_risk == 'critical'"/>
                <field name="state" widget="badge" 
                       decoration-info="state in ('enquiry', 'consultation')"
                       decoration-primary="state in ('confirmed', 'planning')"
                       decoration-warning="state == 'in_execution'"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- Custom Wedding Kanban View -->
    <record id="view_custom_wedding_kanban" model="ir.ui.view">
        <field name="name">custom.wedding.kanban</field>
        <field name="model">custom.wedding</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="destination"/>
                <field name="wedding_date_start"/>
                <field name="guest_count"/>
                <field name="predicted_guests"/>
                <field name="budget_total"/>
                <field name="currency_id"/>
                <field name="margin_drift_risk"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span class="badge rounded-pill bg-light text-dark"><field name="destination"/></span>
                            </div>
                            <div class="text-muted mb-2">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span><i class="fa fa-calendar me-1"/> <field name="wedding_date_start"/></span>
                                <span><i class="fa fa-users me-1"/> <field name="guest_count"/> (ML: <field name="predicted_guests"/>)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fw-bold text-primary">
                                    <field name="budget_total" widget="monetary"/>
                                </span>
                                <field name="margin_drift_risk" widget="badge"
                                       decoration-success="margin_drift_risk == 'low'"
                                       decoration-warning="margin_drift_risk == 'moderate'"
                                       decoration-danger="margin_drift_risk == 'critical'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Custom Wedding Search & Filter View -->
    <record id="view_custom_wedding_search" model="ir.ui.view">
        <field name="name">custom.wedding.search</field>
        <field name="model">custom.wedding</field>
        <field name="arch" type="xml">
            <search string="Search Weddings">
                <field name="name" string="Wedding Reference"/>
                <field name="partner_id" string="Client Couple"/>
                <field name="theme" string="Theme"/>
                <field name="location_id" string="Venue"/>
                <field name="planner_id" string="Lead Planner"/>
                
                <separator/>
                <filter name="my_weddings" string="My Assigned Weddings" 
                        domain="['|', ('planner_id', '=', uid), ('coordinator_ids', 'in', [uid])]"/>
                <filter name="active_planning" string="Active Planning" 
                        domain="[('state', 'in', ('confirmed', 'planning'))]"/>
                <filter name="big_day" string="Big Day Execution" 
                        domain="[('state', '=', 'in_execution')]"/>
                <filter name="critical_risk" string="Critical Margin Risk" 
                        domain="[('margin_drift_risk', '=', 'critical')]"/>
                
                <separator/>
                <filter name="jaipur_weddings" string="Jaipur Weddings" 
                        domain="[('destination', '=', 'jaipur')]"/>
                <filter name="udaipur_weddings" string="Udaipur Weddings" 
                        domain="[('destination', '=', 'udaipur')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_destination" string="Destination" 
                            context="{'group_by': 'destination'}"/>
                    <filter name="group_by_state" string="Status Stage" 
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_package" string="Package Tier" 
                            context="{'group_by': 'package_id'}"/>
                    <filter name="group_by_planner" string="Lead Planner" 
                            context="{'group_by': 'planner_id'}"/>
                    <filter name="group_by_month" string="Wedding Month" 
                            context="{'group_by': 'wedding_date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for Weddings -->
    <record id="action_custom_wedding" model="ir.actions.act_window">
        <field name="name">Royal Weddings</field>
        <field name="res_model">custom.wedding</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_custom_wedding_search"/>
        <field name="context">{'search_default_my_weddings': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new Royal Wedding Event
            </p>
            <p>
                Manage luxury destination weddings in Jaipur and Udaipur from initial enquiry to final settlement.
            </p>
        </field>
    </record>
</odoo>
