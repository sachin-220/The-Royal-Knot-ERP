<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Package 1: Full-Service Luxury Wedding -->
        <record id="package_full_service" model="custom.wedding.package">
            <field name="name">Full-Service Royal Wedding</field>
            <field name="code">FULL_ROYAL</field>
            <field name="sequence">1</field>
            <field name="package_type">full_service</field>
            <field name="base_task_count">28</field>
            <field name="description">Comprehensive end-to-end wedding design, venue procurement, vendor negotiations, 18-category budget guardrails, practice rehearsals, and 3-day on-site command execution.</field>
            <field name="is_active">True</field>
        </record>

        <!-- Package 2: Partial / Day-Of Coordination -->
        <record id="package_day_of" model="custom.wedding.package">
            <field name="name">Day-of Service &amp; Timeline Execution</field>
            <field name="code">DAY_OF_EXEC</field>
            <field name="sequence">2</field>
            <field name="package_type">partial_day_of</field>
            <field name="base_task_count">14</field>
            <field name="description">Minute-by-minute rundown coordination, live vendor arrival check-ins, family timeline cueing, and event breakdown clearance.</field>
            <field name="is_active">True</field>
        </record>
    </data>
</odoo>
