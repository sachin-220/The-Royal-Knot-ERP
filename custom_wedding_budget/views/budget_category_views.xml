<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget Category Tree View -->
    <record id="view_budget_category_tree" model="ir.ui.view">
        <field name="name">knotcore.budget.category.tree</field>
        <field name="model">knotcore.budget.category</field>
        <field name="arch" type="xml">
            <tree string="Budget Benchmark Categories" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_percentage" string="Benchmark %" widget="progressbar"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Budget Category Form View -->
    <record id="view_budget_category_form" model="ir.ui.view">
        <field name="name">knotcore.budget.category.form</field>
        <field name="model">knotcore.budget.category</field>
        <field name="arch" type="xml">
            <form string="Budget Benchmark Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Catering &amp; Royal Banqueting"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="default_percentage" widget="percentage"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope &amp; Scope Details">
                            <field name="description" placeholder="Specify deliverables, average palace costs, and negotiation guidelines..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_category" model="ir.actions.act_window">
        <field name="name">Benchmark Budget Categories</field>
        <field name="res_model">knotcore.budget.category</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Standardize the 18 luxury destination wedding expenditure categories.
            </p>
        </field>
    </record>
</odoo>
