<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Emergency Incidents -->
        <record id="seq_wedding_incident" model="ir.sequence">
            <field name="name">Wedding Incident Sequence</field>
            <field name="code">knotcore.wedding.incident</field>
            <field name="prefix">INC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cron for 15-Minute Late Vendor Gate Tolerance -->
        <record id="cron_check_late_vendors" model="ir.cron">
            <field name="name">Wedding Operations: 15-Minute Late Vendor Gate Tolerance Trigger</field>
            <field name="model_id" ref="model_knotcore_vendor_gate_checkin"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_late_vendors()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
