<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Run Sheet Tree View -->
    <record id="view_wedding_run_sheet_tree" model="ir.ui.view">
        <field name="name">knotcore.wedding.run.sheet.tree</field>
        <field name="model">knotcore.wedding.run.sheet</field>
        <field name="arch" type="xml">
            <tree string="Minute-by-Minute Run Sheet" decoration-danger="status == 'live'" decoration-success="status == 'completed'">
                <field name="sequence" widget="handle"/>
                <field name="wedding_id"/>
                <field name="time_start"/>
                <field name="time_end"/>
                <field name="event_name"/>
                <field name="venue_zone"/>
                <field name="lead_coordinator"/>
                <field name="status" widget="badge" decoration-danger="status == 'live'" decoration-success="status == 'completed'" decoration-info="status == 'upcoming'"/>
                <button name="action_set_live" string="Set LIVE 🔴" type="object" icon="fa-play-circle" invisible="status == 'live'"/>
                <button name="action_set_completed" string="Done ✅" type="object" icon="fa-check" invisible="status == 'completed'"/>
            </tree>
        </field>
    </record>

    <!-- Run Sheet Form View -->
    <record id="view_wedding_run_sheet_form" model="ir.ui.view">
        <field name="name">knotcore.wedding.run.sheet.form</field>
        <field name="model">knotcore.wedding.run.sheet</field>
        <field name="arch" type="xml">
            <form string="Ceremonial Timeline Milestone">
                <header>
                    <button name="action_set_live" string="Activate LIVE Protocol 🔴" type="object" class="oe_highlight" invisible="status == 'live'"/>
                    <button name="action_set_completed" string="Mark Milestone Completed ✅" type="object" class="btn-success" invisible="status == 'completed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="upcoming,live,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="event_name" class="oe_edit_only"/>
                        <h1><field name="event_name" placeholder="e.g. Groom Royal Baraat Arrival"/></h1>
                        <h3><field name="wedding_id"/></h3>
                    </div>
                    <group>
                        <group string="Timing &amp; Zone">
                            <field name="time_start"/>
                            <field name="time_end"/>
                            <field name="venue_zone"/>
                        </group>
                        <group string="Coordination">
                            <field name="lead_coordinator"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Production Cues &amp; Stage Instructions">
                            <field name="cue_notes" placeholder="Audio prompts, pyrotechnic cues, and bride/groom entrances..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wedding_run_sheet" model="ir.actions.act_window">
        <field name="name">Command Centre Run Sheet</field>
        <field name="res_model">knotcore.wedding.run.sheet</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Inherit custom.wedding Form to add Operations Tabs -->
    <record id="view_wedding_form_inherit_operations" model="ir.ui.view">
        <field name="name">custom.wedding.form.inherit.operations</field>
        <field name="model">custom.wedding</field>
        <field name="inherit_id" ref="custom_wedding_core.view_wedding_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_operational_task_graph" string="Construct 26-Node Task Graph" type="object" class="btn-secondary" invisible="state == 'completed'"/>
                <button name="action_generate_default_run_sheet" string="Populate Run Sheet" type="object" class="btn-secondary" invisible="state == 'completed'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Task Graph (26 Milestones)" name="task_graph">
                    <field name="task_ids">
                        <tree decoration-danger="urgency == 'critical'" decoration-warning="urgency == 'high'" decoration-success="state == 'completed'">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="task_phase" widget="badge"/>
                            <field name="days_before_wedding" string="T-Minus"/>
                            <field name="deadline_date"/>
                            <field name="urgency" widget="badge"/>
                            <field name="state" widget="badge"/>
                            <button name="action_complete" string="Complete" type="object" icon="fa-check-circle" invisible="state == 'completed'"/>
                        </tree>
                    </field>
                </page>
                <page string="Command Run Sheet" name="run_sheet">
                    <field name="run_sheet_ids">
                        <tree decoration-danger="status == 'live'" decoration-success="status == 'completed'">
                            <field name="sequence" widget="handle"/>
                            <field name="time_start"/>
                            <field name="time_end"/>
                            <field name="event_name"/>
                            <field name="venue_zone"/>
                            <field name="lead_coordinator"/>
                            <field name="status" widget="badge"/>
                            <button name="action_set_live" string="LIVE 🔴" type="object" icon="fa-play-circle" invisible="status == 'live'"/>
                        </tree>
                    </field>
                </page>
                <page string="Palace Gate Check-Ins" name="gate_checkins">
                    <field name="gate_checkin_ids">
                        <tree decoration-danger="status == 'delayed_alert'" decoration-success="status == 'arrived'">
                            <field name="name"/>
                            <field name="vendor_id"/>
                            <field name="venue_gate"/>
                            <field name="gate_otp"/>
                            <field name="scheduled_call_time"/>
                            <field name="actual_arrival_time"/>
                            <field name="status" widget="badge"/>
                        </tree>
                    </field>
                </page>
                <page string="Emergency Incidents" name="incidents">
                    <field name="incident_ids">
                        <tree decoration-danger="severity in ('critical', 'high')" decoration-success="state == 'resolved'">
                            <field name="name"/>
                            <field name="title"/>
                            <field name="category"/>
                            <field name="severity" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
                <page string="Delay Ripple Simulator" name="delay_sim">
                    <field name="delay_simulator_ids">
                        <tree decoration-danger="curfew_violation_risk">
                            <field name="delayed_event_name"/>
                            <field name="delay_minutes"/>
                            <field name="affected_events_count"/>
                            <field name="curfew_violation_risk" widget="boolean_toggle"/>
                            <field name="estimated_overtime_cost"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
