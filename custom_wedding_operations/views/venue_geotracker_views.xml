<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GeoTracker Tree View -->
    <record id="view_venue_geotracker_tree" model="ir.ui.view">
        <field name="name">knotcore.venue.geotracker.tree</field>
        <field name="model">knotcore.venue.geotracker</field>
        <field name="arch" type="xml">
            <tree string="Live Venue &amp; Fleet GPS Tracker" decoration-danger="geofence_status == 'traffic_delay'" decoration-success="geofence_status == 'inside_venue'" decoration-warning="geofence_status == 'approaching'">
                <field name="name"/>
                <field name="wedding_id"/>
                <field name="entity_type" widget="badge"/>
                <field name="destination"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="geofence_status" widget="badge" decoration-danger="geofence_status == 'traffic_delay'" decoration-success="geofence_status == 'inside_venue'" decoration-warning="geofence_status == 'approaching'"/>
                <field name="eta_minutes" string="ETA (Mins)"/>
                <field name="last_gps_ping"/>
            </tree>
        </field>
    </record>

    <!-- GeoTracker Form View -->
    <record id="view_venue_geotracker_form" model="ir.ui.view">
        <field name="name">knotcore.venue.geotracker.form</field>
        <field name="model">knotcore.venue.geotracker</field>
        <field name="arch" type="xml">
            <form string="Live GPS &amp; Fleet Tracker">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="wedding_id"/></h3>
                    </div>
                    <group>
                        <group string="Telemetry Details">
                            <field name="entity_type" widget="badge"/>
                            <field name="destination"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group string="Real-Time Geofence &amp; Traffic">
                            <field name="geofence_status" widget="badge"/>
                            <field name="eta_minutes"/>
                            <field name="vendor_partner_id"/>
                            <field name="driver_phone"/>
                            <field name="last_gps_ping"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_venue_geotracker" model="ir.actions.act_window">
        <field name="name">Live Geographic Location Map &amp; Fleet Tracker</field>
        <field name="res_model">knotcore.venue.geotracker</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
