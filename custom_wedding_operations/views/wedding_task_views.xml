<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wedding Task Tree View -->
    <record id="view_wedding_task_tree" model="ir.ui.view">
        <field name="name">custom.wedding.task.tree</field>
        <field name="model">custom.wedding.task</field>
        <field name="arch" type="xml">
            <tree string="Operational Tasks" decoration-danger="urgency == 'critical'" decoration-warning="urgency == 'high'" decoration-success="state == 'completed'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="wedding_id"/>
                <field name="task_phase" widget="badge"/>
                <field name="days_before_wedding" string="T-Minus (Days)"/>
                <field name="deadline_date"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="urgency" widget="badge" decoration-danger="urgency == 'critical'" decoration-warning="urgency == 'high'"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-muted="state == 'todo'"/>
            </tree>
        </field>
    </record>

    <!-- Wedding Task Form View -->
    <record id="view_wedding_task_form" model="ir.ui.view">
        <field name="name">custom.wedding.task.form</field>
        <field name="model">custom.wedding.task</field>
        <field name="arch" type="xml">
            <form string="Operational Milestone Task">
                <header>
                    <button name="action_start" string="Start Task" type="object" invisible="state != 'todo'" class="oe_highlight"/>
                    <button name="action_complete" string="Mark as Completed ✅" type="object" invisible="state in ('completed', 'cancelled')" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Milestone Task Title..."/></h1>
                        <h3><field name="wedding_id"/></h3>
                    </div>
                    <group>
                        <group string="Phase &amp; Predecessor">
                            <field name="task_phase"/>
                            <field name="predecessor_task_id"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Schedule &amp; Responsibility">
                            <field name="days_before_wedding"/>
                            <field name="deadline_date"/>
                            <field name="assigned_user_id"/>
                            <field name="urgency" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Execution Notes &amp; Vendor Checklist">
                            <field name="notes" placeholder="Detailed guidelines, contact numbers, and delivery instructions..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wedding_task" model="ir.actions.act_window">
        <field name="name">Operational Milestone Tasks</field>
        <field name="res_model">custom.wedding.task</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
