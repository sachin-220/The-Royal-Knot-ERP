<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Incident Tree View -->
    <record id="view_wedding_incident_tree" model="ir.ui.view">
        <field name="name">knotcore.wedding.incident.tree</field>
        <field name="model">knotcore.wedding.incident</field>
        <field name="arch" type="xml">
            <tree string="Emergency Incidents" decoration-danger="severity in ('critical', 'high')" decoration-success="state == 'resolved'">
                <field name="name"/>
                <field name="wedding_id"/>
                <field name="title"/>
                <field name="category" widget="badge"/>
                <field name="severity" widget="badge" decoration-danger="severity in ('critical', 'high')" decoration-warning="severity == 'medium'" decoration-info="severity == 'low'"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge" decoration-success="state == 'resolved'" decoration-warning="state == 'dispatched'" decoration-danger="state == 'reported'"/>
            </tree>
        </field>
    </record>

    <!-- Incident Form View -->
    <record id="view_wedding_incident_form" model="ir.ui.view">
        <field name="name">knotcore.wedding.incident.form</field>
        <field name="model">knotcore.wedding.incident</field>
        <field name="arch" type="xml">
            <form string="Wedding Emergency Incident Ticket">
                <header>
                    <button name="action_dispatch" string="Dispatch Response Team 🚚" type="object" invisible="state != 'reported'" class="oe_highlight"/>
                    <button name="action_resolve" string="Mark as Resolved ✅" type="object" invisible="state == 'resolved'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="reported,dispatched,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="title" placeholder="Brief summary (e.g. Generator tripped on main lawn)..."/></h2>
                    </div>

                    <group>
                        <group string="Incident Classification">
                            <field name="wedding_id"/>
                            <field name="category"/>
                            <field name="severity" widget="badge"/>
                        </group>
                        <group string="Response &amp; Resolution">
                            <field name="assigned_user_id"/>
                            <field name="resolution_time_minutes" string="Resolution Time (Mins)"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detailed Incident Description">
                            <field name="description" placeholder="Specify equipment required, venue location, and immediate danger..."/>
                        </page>
                        <page string="Resolution Notes &amp; Root Cause">
                            <field name="resolution_notes" placeholder="Actions taken to restore operations..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wedding_incident" model="ir.actions.act_window">
        <field name="name">Emergency Incidents</field>
        <field name="res_model">knotcore.wedding.incident</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
